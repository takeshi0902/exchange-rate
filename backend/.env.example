# 複製此檔為 .env，填入實際值

# Discord Webhook URL（爬蟲失敗時通知）
# 到 Discord 頻道 → 設定 → 整合 → Webhook → 建立 Webhook → 複製 URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# SQLite 資料庫路徑（Render 用 /var/data/rates.db；本機開發用 rates.db）
DATABASE_PATH=rates.db

# 爬蟲間隔（小時）
SCRAPE_INTERVAL_HOURS=1

# CORS 允許來源（上線後改為你的 GitHub Pages 網址）
# 多個來源用逗號分隔
CORS_ORIGINS=http://localhost:8787,https://yourusername.github.io
